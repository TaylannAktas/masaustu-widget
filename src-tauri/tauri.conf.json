{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Masaüstü Widget",
  "version": "0.1.0",
  "identifier": "com.taylan.masaustuwidget",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis",
      "msi"
    ],
    "publisher": "TaylannAktas",
    "copyright": "© 2026 TaylannAktas — MIT",
    "category": "Utility",
    "shortDescription": "Masaüstüne gömülen, HTML/JS ile yazılan canlı widget'lar",
    "longDescription": "Widget'ları duvar kağıdı katmanına, ikonların arkasına gömer. İçerik serbest HTML/CSS/JS; görünmediğinde otomatik donar.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "languages": [
          "Turkish"
        ],
        "installMode": "currentUser"
      }
    }
  }
}
